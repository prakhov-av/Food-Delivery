# Server
PORT=3000
DB_SSL=false
SERVER_HOST=localhost
SERVER_PORT=3000

# PostgreSQL is currently configured directly in src/app.module.ts.
# Do not place production database credentials in source code.

# JWT: use unique high-entropy secrets (at least 32 random bytes each).
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password

# AI provider selection: gemini or openai
PRIMARY_GENERATION_AI_PROVIDER=gemini
PRIMARY_EMBEDDINGS_AI_PROVIDER=gemini

# Gemini. URLs must include every fixed path and query delimiter required before the key.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=
GEMINI_EMBEDDING_URL=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent?key=

# OpenAI-compatible Responses and embeddings endpoints
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://localhost:6333
KNOWLEDGE_DB_COLLECTION_NAME=food_delivery_knowledge
ARCHIVE_DB_COLLECTION_NAME=food_delivery_knowledge_archive

# RAG chunking (words) and chat context
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MAX_CONTEXT_LENGTH_IN_WORDS=1500
