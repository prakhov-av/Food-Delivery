# Server
PORT=3000
DB_SSL=false
SERVER_HOST=localhost
SERVER_PORT=3000

# PostgreSQL is currently configured directly in src/app.module.ts.
# Do not place production database credentials in source code.

# JWT: use unique high-entropy secrets (at least 32 random bytes each).
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password

# AI provider selection: gemini or openai
PRIMARY_GENERATION_AI_PROVIDER=gemini
PRIMARY_EMBEDDINGS_AI_PROVIDER=gemini

# Gemini. URLs must include every fixed path and query delimiter required before the key.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=
GEMINI_EMBEDDING_URL=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent?key=

# OpenAI-compatible Responses and embeddings endpoints
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4.1-mini
# Model of the question classifier. It answers with a short JSON, so a faster
# and cheaper model is enough and the user gets the answer sooner.
# Empty: the same model as for the answer.
OPENAI_CLASSIFIER_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://localhost:6333
KNOWLEDGE_DB_COLLECTION_NAME=food_delivery_knowledge
ARCHIVE_DB_COLLECTION_NAME=food_delivery_knowledge_archive

# Size of the embedding vector of the collection.
# It must match the model of the embedding provider: text-embedding-004 gives
# 768 by default, text-embedding-3-small gives 1536.
QDRANT_VECTOR_SIZE=1536

# Timeout of one request to Qdrant, ms.
QDRANT_TIMEOUT_MS=5000

# RAG chunking (words) and chat context
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MAX_CONTEXT_LENGTH_IN_WORDS=1500

# Chat language detection.
# The language is taken from the interface first; the detector is only trusted
# for long messages, short ones keep the language of the previous message.
CHAT_LANG_DETECT_MIN_CHARS=40
CHAT_LANG_DETECT_MIN_WORDS=5

# Minimum accuracy of the language detector.
# Below it the detector is not trusted: a French text used to get German
# when German was somewhere in the tail of the list.
CHAT_LANG_DETECT_MIN_ACCURACY=0.5

# Below this score the retrieval repeats the search in the default language:
# a document in another language is better than "no information".
CHAT_LANG_FALLBACK_MIN_SCORE=0.3

# Below this score a chunk does not go into the context.
# Pick it with the eval set, not by eye.
CHAT_MIN_SCORE=0

# How many messages one identity may send per day.
# 0 disables the limit.
CHAT_DAILY_LIMIT=100

# How many days the chat messages are stored.
# Older rows are deleted when a new message is written.
CHAT_HISTORY_RETENTION_DAYS=30

# Creates the keyword index for the language field in Qdrant.
# Off by default: the collection is shared and its schema is not changed
# silently at application start.
QDRANT_CREATE_PAYLOAD_INDEXES=false
